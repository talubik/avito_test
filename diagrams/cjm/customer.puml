@startuml CustomerCJM
!theme plain
title CJM пользователя Авито.Кухни
start
:Открыть список заведений;
:Выбрать заведение и изучить меню;
if (Нужная позиция доступна?) then (да)
  :Добавить позицию в корзину;
else (нет)
  :Выбрать альтернативу;
endif
if (Товар другого заведения?) then (да)
  :Показать конфликт одной корзины;
  :Очистить корзину либо оставить текущую;
endif
:Указать адрес, телефон и комментарий;
:Отправить checkout с Idempotency-Key;
if (Цена и доступность актуальны?) then (да)
  :Получить заказ pending_restaurant;
else (нет)
  :Показать изменившиеся позиции;
  stop
endif
if (Ресторан принял?) then (да)
  :Наблюдать accepted → preparing;
  :Наблюдать доставку;
  :Получить delivered;
else (нет)
  :Получить rejected с причиной;
endif
stop
@enduml
